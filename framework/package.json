{
  "name": "pithjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny framework built on native web tech: no runtime dependencies, no build step. Import it as 'pith'.",
  "license": "MIT",
  "bin": {
    "pith": "tools/cli.mjs"
  },
  "exports": {
    ".": "./pith/index.js",
    "./testing": "./tests/harness.js",
    "./min": "./pith/pith.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "pith",
    "tools",
    "tests",
    "docs",
    "template",
    "skills",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/",
    "check": "node tools/check.mjs",
    "types": "npx -y -p typescript@5.9.3 tsc -p jsconfig.json"
  },
  "engines": {
    "node": ">=24"
  }
}
